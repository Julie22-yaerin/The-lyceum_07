# Supabase (used for the videos/topics/friendships/direct_messages cache — see supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fetching providers for app/api/v1/media/resolve
# Iframely is tried first for tiktok/instagram/twitter; Microlink is the fallback.
IFRAMELY_API_KEY=

# OpenRouter (app/api/v1/ai/generate-quiz) — up to 3 keys, tried in order as a
# fallback chain if one is rate-limited or rejected. Only the first is required.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
# Any OpenRouter model id (https://openrouter.ai/models). Defaults to openai/gpt-4o-mini.
OPENROUTER_MODEL=
